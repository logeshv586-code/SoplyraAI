<Window x:Class="SoplyraAI.Views.CaptureBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoplyraAI Capture" Width="430" Height="92" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <Border Background="#FBFBFE" BorderBrush="#DDDFF0" BorderThickness="1" CornerRadius="20" Padding="13">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.20" Color="#14131F"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource BrandGradient}" Margin="0,0,12,0">
                <Grid>
                    <Ellipse Width="12" Height="12" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SoplyraAI is recording" FontWeight="SemiBold" Foreground="#171722"/>
                    <Border Background="#FDECEC" CornerRadius="6" Padding="6,2" Margin="8,0,0,0"><TextBlock Text="LIVE" Foreground="#D63B3B" FontSize="9" FontWeight="Bold"/></Border>
                </StackPanel>
                <TextBlock x:Name="StepText" Text="0 steps captured" Foreground="#737386" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="PauseButton" Grid.Column="2" Content="Pause" Style="{StaticResource GhostButton}" Click="PauseButton_Click" Margin="8,0" Padding="13,8"/>
            <Button Grid.Column="3" Content="Stop capture" Click="StopButton_Click" Margin="0" Padding="14,8" Background="#171722" BorderBrush="#171722" Foreground="White"/>
        </Grid>
    </Border>
</Window>
