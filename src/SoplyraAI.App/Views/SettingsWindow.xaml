<Window x:Class="SoplyraAI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoplyraAI settings" Width="680" Height="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F6F7FB">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource BrandGradient}" Margin="0,0,14,0">
                <TextBlock Text="✦" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="AI &amp; capture settings" FontSize="25" FontWeight="SemiBold" Foreground="#171722"/>
                <TextBlock Text="Tune the recorder without giving up local-first privacy." Foreground="#70748A" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E6E7EF" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,22,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#F4F1FF" CornerRadius="12" Padding="14" Margin="0,0,0,20">
                        <CheckBox x:Name="UseAiCheck" Content="Enable AI-enhanced step descriptions" FontWeight="SemiBold" Foreground="#4F46C8"/>
                    </Border>

                    <TextBlock Text="LOCAL / OPENAI-COMPATIBLE MODEL" FontSize="10" FontWeight="Bold" Foreground="#8A8A9D" Margin="0,0,0,10"/>
                    <TextBlock Text="Endpoint" FontWeight="SemiBold"/>
                    <TextBox x:Name="EndpointBox" Margin="0,6,0,14"/>
                    <TextBlock Text="Model name" FontWeight="SemiBold"/>
                    <TextBox x:Name="ModelBox" Margin="0,6,0,14"/>
                    <TextBlock Text="API key" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="ApiKeyBox" Margin="0,6,0,20" Padding="9,7" BorderBrush="#E7E8EF"/>

                    <Separator Margin="0,0,0,18"/>
                    <TextBlock Text="CAPTURE BEHAVIOR" FontSize="10" FontWeight="Bold" Foreground="#8A8A9D" Margin="0,0,0,10"/>
                    <TextBlock Text="Screenshot mode" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ScreenshotModeBox" Margin="0,6,0,14">
                        <ComboBoxItem Content="ActiveWindow"/>
                        <ComboBoxItem Content="FullDesktop"/>
                    </ComboBox>
                    <TextBlock Text="Screenshot delay after click (milliseconds)" FontWeight="SemiBold"/>
                    <TextBox x:Name="DelayBox" Margin="0,6,0,20"/>

                    <Border Background="#F0F8F5" BorderBrush="#DCEFE7" BorderThickness="1" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#12A36D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Recommended fast local setup" FontWeight="SemiBold" Foreground="#0D7D54"/>
                            </StackPanel>
                            <TextBlock Text="Install Ollama if required and download qwen2.5:0.5b. SoplyraAI sends UI metadata to the model—not your screenshots." TextWrapping="Wrap" Foreground="#58736A" Margin="0,7,0,12"/>
                            <Button x:Name="SetupButton" Content="Set up local AI" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SetupButton_Click"/>
                            <TextBlock x:Name="SetupStatus" TextWrapping="Wrap" Foreground="#58736A" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
            <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
