<Window x:Class="SoplyraAI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoplyraAI · AI setup" Width="900" Height="760" MinWidth="820" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="#F7F8FC">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="54" Height="54" CornerRadius="17" Background="{StaticResource BrandGradient}" Margin="0,0,15,0">
                <TextBlock Text="S" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Text="Choose your AI engine" FontSize="27" FontWeight="SemiBold" Foreground="#171824"/>
                <TextBlock Text="Use a private local model or connect your own cloud API key. You stay in control of what leaves this PC." Foreground="#73778D" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="White" BorderBrush="#DCDFF0" BorderThickness="1" CornerRadius="16" Padding="17">
                        <RadioButton x:Name="LocalRadio" GroupName="Engine" Checked="EngineMode_Changed" IsChecked="True">
                            <StackPanel><TextBlock Text="Local · Ollama" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Private, fast, no API key" Foreground="#74788D" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                        </RadioButton>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="#DCDFF0" BorderThickness="1" CornerRadius="16" Padding="17">
                        <RadioButton x:Name="CloudRadio" GroupName="Engine" Checked="EngineMode_Changed">
                            <StackPanel><TextBlock Text="Cloud API" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="DeepSeek · OpenAI · NVIDIA · Gemini · Anthropic" Foreground="#74788D" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                        </RadioButton>
                    </Border>
                </Grid>

                <Border x:Name="LocalPanel" Background="White" BorderBrush="#E1E3EF" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Width="76" Height="76" CornerRadius="22" Background="#F2F0FF" HorizontalAlignment="Left"><TextBlock Text="◉" Foreground="#6857E8" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Ollama" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0"/>
                            <TextBlock Text="Runs on this Windows device. No API key required." Foreground="#73778D" TextWrapping="Wrap" Margin="0,6,22,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Recommended model" FontWeight="SemiBold"/>
                            <ComboBox x:Name="LocalModelBox" Margin="0,7,0,10"/>
                            <TextBlock Text="qwen3:4b — documentation · qwen2.5vl:3b — vision · deepseek-r1:7b — reasoning · gemma3:4b — multimodal" Foreground="#73778D" TextWrapping="Wrap" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <Button x:Name="SetupButton" Content="Install / download model" Style="{StaticResource PrimaryButton}" Click="SetupButton_Click"/>
                                <Button Content="Test connection" Style="{StaticResource GhostButton}" Click="TestButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="CloudPanel" Visibility="Collapsed" Background="White" BorderBrush="#E1E3EF" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Provider" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ProviderBox" Margin="0,7,0,14" SelectionChanged="ProviderBox_SelectionChanged"/>
                            <TextBlock Text="Model" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ModelBox" IsEditable="True" Margin="0,7,0,14"/>
                            <TextBlock x:Name="ProviderNote" Foreground="#73778D" TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="API key" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="ApiKeyBox" Margin="0,7,0,14" Padding="10,8" BorderBrush="#E1E3EF"/>
                            <CheckBox x:Name="VisionCheck" Content="Allow screenshot vision analysis" FontWeight="SemiBold"/>
                            <TextBlock Text="When enabled, the current step screenshot may be sent to the selected cloud provider. Leave off for metadata-only AI." Foreground="#8A6A50" TextWrapping="Wrap" FontSize="11" Margin="22,5,0,14"/>
                            <Button Content="Test API connection" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="TestButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#F2F9F6" BorderBrush="#D7ECE4" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Privacy guard" FontWeight="SemiBold" Foreground="#137B59"/>
                        <TextBlock Text="Password-field steps are never sent to AI. API keys are encrypted with Windows DPAPI. Remote providers require HTTPS and screenshots are only sent when you explicitly enable vision." Foreground="#53766A" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E1E3EF" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Capture" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Screenshot mode" Margin="0,12,0,0"/>
                            <ComboBox x:Name="ScreenshotModeBox" Margin="0,6,0,10"><ComboBoxItem Content="ActiveWindow"/><ComboBoxItem Content="FullDesktop"/></ComboBox>
                            <TextBlock Text="Delay after click (ms)"/>
                            <TextBox x:Name="DelayBox" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Default export" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Format" Margin="0,12,0,0"/>
                            <ComboBox x:Name="ExportFormatBox" Margin="0,6,0,10"><ComboBoxItem Content="PDF"/><ComboBoxItem Content="Word"/><ComboBoxItem Content="HTML"/><ComboBoxItem Content="All"/></ComboBox>
                            <TextBlock Text="You can change the format from the main toolbar before each export." Foreground="#73778D" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="SetupStatus" TextWrapping="Wrap" Foreground="#596078" Margin="3,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
            <Button Content="Save &amp; continue" Style="{StaticResource PrimaryButton}" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
