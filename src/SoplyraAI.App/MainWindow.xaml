<Window x:Class="SoplyraAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SoplyraAI.Models"
        Title="SoplyraAI — AI Workflow Documentation" Width="1480" Height="900"
        MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="284"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Premium left navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="22,24,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource BrandGradient}" Margin="0,0,12,0">
                            <TextBlock Text="S" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SoplyraAI" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock Text="Workflow intelligence" Foreground="#868699" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Record work. Generate clarity." Foreground="#B0B0BF" FontSize="12" Margin="0,14,0,0"/>
                </StackPanel>

                <Button Grid.Row="1" Content="＋  Create new guide" Style="{StaticResource PrimaryButton}" Margin="0,26,0,20" Click="NewGuide_Click"/>

                <Border Grid.Row="2" Background="#1E1D2B" CornerRadius="12" Padding="12" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#37D39A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="LOCAL-FIRST ENGINE" Foreground="#C7C7D6" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Screenshots stay on your PC. AI receives lightweight UI context only." Foreground="#838397" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="RECENT GUIDES" Foreground="#6F6F82" FontSize="10" FontWeight="Bold" Margin="2,0,0,10"/>
                    <ListBox x:Name="SessionList" SelectionChanged="SessionList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GuideSession}">
                                <Border Background="#1E1D2B" CornerRadius="11" Padding="11" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd MMM · HH:mm}}" Foreground="#77778B" FontSize="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="›" Foreground="#6E6E82" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Grid.Row="4" Background="#1A1926" CornerRadius="12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Private by design" Foreground="#C9C9D7" FontWeight="SemiBold"/>
                        <TextBlock Text="No account required · Local sessions · Password masking" Foreground="#77778A" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Column="1" Margin="28,24,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="AI DOCUMENTATION STUDIO" Foreground="#6C5CE7" FontSize="10" FontWeight="Bold"/>
                    <TextBox x:Name="GuideTitle" Text="Untitled guide" FontSize="28" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,5,0,0" Width="610" LostFocus="GuideTitle_LostFocus"/>
                    <TextBlock Text="Capture any Windows workflow and turn it into a polished, editable SOP." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ImproveButton" Content="✦  Improve with AI" Style="{StaticResource GhostButton}" Click="ImproveAll_Click"/>
                    <Button Content="Export  ↗" Style="{StaticResource GhostButton}" Click="Export_Click"/>
                    <Button x:Name="StartButton" Content="●  Start capture" Style="{StaticResource PrimaryButton}" Margin="0" Click="StartCapture_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- Hero command card -->
            <Border Grid.Row="1" Background="{StaticResource BrandGradient}" CornerRadius="20" Padding="22" Margin="0,22,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="From action to documentation — automatically." Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="SoplyraAI detects what you clicked, captures the resulting screen, understands the control, and writes the step for you." Foreground="#E8E5FF" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" MaxWidth="780"/>
                        <WrapPanel Margin="0,16,0,0">
                            <Border Background="#25FFFFFF" CornerRadius="9" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="✓ UI Automation" Foreground="White" FontSize="11"/></Border>
                            <Border Background="#25FFFFFF" CornerRadius="9" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="✓ Smart screenshots" Foreground="White" FontSize="11"/></Border>
                            <Border Background="#25FFFFFF" CornerRadius="9" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="✓ Local AI ready" Foreground="White" FontSize="11"/></Border>
                            <Border Background="#25FFFFFF" CornerRadius="9" Padding="10,6"><TextBlock Text="✓ PDF / HTML / Markdown" Foreground="White" FontSize="11"/></Border>
                        </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="AI &amp; capture settings  ⚙" Background="#22FFFFFF" BorderBrush="#55FFFFFF" Foreground="White" Margin="26,0,0,0" VerticalAlignment="Top" Click="Settings_Click"/>
                </Grid>
            </Border>

            <!-- Capability strip -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="#F1EFFF" Margin="0,0,11,0"><TextBlock Text="◎" FontSize="20" Foreground="#6658E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel><TextBlock Text="Action-aware capture" FontWeight="SemiBold"/><TextBlock Text="Understands clicked controls" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="#ECF8F4" Margin="0,0,11,0"><TextBlock Text="◈" FontSize="19" Foreground="#12A36D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel><TextBlock Text="Privacy-first AI" FontWeight="SemiBold"/><TextBlock Text="Metadata-first, local-ready" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="#EEF5FF" Margin="0,0,11,0"><TextBlock Text="↗" FontSize="19" Foreground="#2F80ED" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel><TextBlock Text="Share-ready exports" FontWeight="SemiBold"/><TextBlock Text="HTML, Markdown and PDF" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3">
                <Border x:Name="EmptyState" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="54">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" MaxWidth="560">
                            <Border Width="74" Height="74" CornerRadius="22" Background="#F1EFFF" HorizontalAlignment="Left" Margin="0,0,0,20">
                                <TextBlock Text="●" FontSize="32" Foreground="#6C5CE7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Document the process while you do the work." FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Start recording, work normally in any desktop app, and SoplyraAI builds the guide in the background. Review the screenshots, refine the wording, then export a professional SOP." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="21" Margin="0,12,20,22"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="●  Start my first capture" Style="{StaticResource PrimaryButton}" Click="StartCapture_Click"/>
                                <Button Content="Configure local AI" Style="{StaticResource GhostButton}" Click="Settings_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#F8F8FC" BorderBrush="#E8E8F1" BorderThickness="1" CornerRadius="18" Padding="20" Margin="30,0,0,0" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="LIVE CAPTURE PREVIEW" Foreground="#8A8A9D" FontSize="10" FontWeight="Bold"/>
                                <Border Background="#191824" CornerRadius="13" Margin="0,13,0,12" Padding="16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#FF5F57" Margin="0,0,6,0"/><Ellipse Width="8" Height="8" Fill="#FFBD2E" Margin="0,0,6,0"/><Ellipse Width="8" Height="8" Fill="#28C840"/>
                                        </StackPanel>
                                        <Border Background="#2A2937" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                                            <TextBlock Text="Customer Portal  ·  New Request" Foreground="#C9C9D7" FontSize="11"/>
                                        </Border>
                                        <Border Background="#6C5CE7" CornerRadius="8" Padding="12,8" Width="145" HorizontalAlignment="Right" Margin="0,26,0,12">
                                            <TextBlock Text="Submit request" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="11" Padding="13" BorderBrush="#E7E7EF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="STEP 06" Foreground="#6C5CE7" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Submit the request" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0"/>
                                        <TextBlock Text="Click “Submit request” to send the completed request for processing." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="StepsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="StepsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GuideStep}">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="310"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource BrandGradient}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" Height="178" BorderBrush="#ECECF3" BorderThickness="1" CornerRadius="12" Margin="0,0,20,0" ClipToBounds="True" Background="#F7F7FA">
                                            <Image Source="{Binding ScreenshotPath}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="0,3,20,0">
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="17" BorderThickness="0" Padding="0" Background="Transparent"/>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,12" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="62"/>
                                            <WrapPanel>
                                                <Border Background="#F3F0FF" CornerRadius="7" Padding="8,4" Margin="0,0,6,0"><TextBlock Text="{Binding Action}" FontSize="10" Foreground="#6256C9"/></Border>
                                                <Border Background="#F4F5F8" CornerRadius="7" Padding="8,4" Margin="0,0,6,0"><TextBlock Text="{Binding Context.ControlType}" FontSize="10" Foreground="#646472"/></Border>
                                                <Border Background="#F4F5F8" CornerRadius="7" Padding="8,4"><TextBlock Text="{Binding Context.ProcessName}" FontSize="10" Foreground="#646472"/></Border>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="Remove" Style="{StaticResource GhostButton}" Tag="{Binding}" Click="DeleteStep_Click" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
