<Window x:Class="SoplyraAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SoplyraAI.Models"
        Title="SoplyraAI — Classic AI Workflow Documentation" Width="1500" Height="920"
        MinWidth="1220" MinHeight="760" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="20,24,20,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource BrandGradient}" Margin="0,0,12,0">
                            <TextBlock Text="S" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SoplyraAI" Foreground="#0F172A" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Workflow Intelligence" Foreground="#64748B" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Record actions. Produce executive guides." Foreground="#64748B" FontSize="12" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Create New Guide Button -->
                <Button Grid.Row="1" Content="＋  New guide" Style="{StaticResource PrimaryButton}" Margin="0,20,0,16" Click="NewGuide_Click"/>

                <!-- AI Engine Panel -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AI INSTRUCTION ENGINE" Foreground="#4F46E5" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="EngineNameText" Text="Ollama · Local" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0" Foreground="#0F172A"/>
                                <TextBlock x:Name="EngineModelText" Text="qwen2.5:0.5b" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#059669" VerticalAlignment="Top" Margin="8,4,0,0"/>
                        </Grid>
                        <TextBlock x:Name="EngineVisionText" Text="Metadata-only AI" Foreground="#64748B" FontSize="10" Margin="0,8,0,0"/>
                        <Button Content="Configure Engine" Style="{StaticResource SoftButton}" Margin="0,10,0,0" Click="Settings_Click"/>
                    </StackPanel>
                </Border>

                <!-- Recent Guides List -->
                <DockPanel Grid.Row="3">
                    <TextBlock DockPanel.Dock="Top" Text="SAVED WORKFLOWS" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="2,0,0,8"/>
                    <ListBox x:Name="SessionList" SelectionChanged="SessionList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource GuideListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GuideSession}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="#0F172A" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd MMM · HH:mm}}" Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✎" Tag="{Binding}" ToolTip="Rename this saved workflow" Style="{StaticResource GhostButton}" Padding="7,4" FontSize="11" Margin="6,0,4,0" VerticalAlignment="Center" Click="RenameGuide_Click"/>
                                    <Button Grid.Column="2" Content="↗" Tag="{Binding}" ToolTip="Export this guide" Style="{StaticResource GhostButton}" Padding="7,4" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" Click="ExportSidebarGuide_Click"/>
                                    <Button Grid.Column="3" Content="×" Tag="{Binding}" ToolTip="Delete guide" Style="{StaticResource DangerButton}" Margin="0" VerticalAlignment="Center" Click="DeleteGuide_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Privacy & Local-first Badge -->
                <Border Grid.Row="4" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="🔒  Local &amp; Private by Default" Foreground="#166534" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text="Local storage · Zero telemetry · Safe exports" Foreground="#15803D" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Main Workspace -->
        <Grid Grid.Column="1" Margin="32,24,32,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- Top Header & Actions -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ACTIVE WORKFLOW GUIDE" Foreground="#4F46E5" FontSize="10" FontWeight="Bold"/>
                    <TextBox x:Name="GuideTitle" Text="Untitled guide" FontSize="26" FontWeight="Bold" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,4,0,0" Width="680" HorizontalAlignment="Left" Foreground="#0F172A" LostFocus="GuideTitle_LostFocus"/>
                    <TextBlock Text="Edit steps below, enhance wording with local AI, or export directly to PDF, Word, or HTML." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ImproveButton" Content="✦  Improve with AI" Style="{StaticResource GhostButton}" Click="ImproveAll_Click"/>
                    <ComboBox x:Name="ExportFormatBox" Width="170" Margin="0,0,8,0" VerticalAlignment="Center">
                        <ComboBoxItem Content="All Formats (PDF, DOCX, HTML, MD)"/>
                        <ComboBoxItem Content="PDF Document (.pdf)"/>
                        <ComboBoxItem Content="Word Document (.docx)"/>
                        <ComboBoxItem Content="Web Guide (.html)"/>
                        <ComboBoxItem Content="Markdown (.md)"/>
                    </ComboBox>
                    <Button Content="Export Guide  ↗" Style="{StaticResource PrimaryButton}" Click="Export_Click"/>
                    <Button x:Name="StartButton" Content="●  Start capture" Style="{StaticResource GhostButton}" Margin="0" Click="StartCapture_Click"/>
                </StackPanel>
            </Grid>

            <!-- Banner / Workflow Info Card -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,20,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#EEF2FF" Margin="0,0,12,0">
                                <TextBlock Text="✦" Foreground="#4F46E5" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Executive Workflow Studio" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Action-aware recording with deterministic descriptions and local AI rewriting." Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="0,0,6,6"><TextBlock Text="Ollama" FontSize="11" Foreground="#475569" FontWeight="Medium"/></Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="0,0,6,6"><TextBlock Text="DeepSeek" FontSize="11" Foreground="#475569" FontWeight="Medium"/></Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="0,0,6,6"><TextBlock Text="OpenAI" FontSize="11" Foreground="#475569" FontWeight="Medium"/></Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="0,0,6,6"><TextBlock Text="Gemini" FontSize="11" Foreground="#475569" FontWeight="Medium"/></Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="0,0,6,6"><TextBlock Text="Anthropic" FontSize="11" Foreground="#475569" FontWeight="Medium"/></Border>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OUTPUT FORMAT &amp; STYLE" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="ModeStatusText" Text="Quick visual guide" FontSize="15" FontWeight="Bold" Margin="0,4,0,0" Foreground="#0F172A"/>
                                <TextBlock Text="Crisp light-theme layout optimized for PDF and web." Foreground="#64748B" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Settings ⚙" Style="{StaticResource SoftButton}" Margin="10,0,0,0" VerticalAlignment="Center" Click="Settings_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Feature Pills -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#EEF2FF" Margin="0,0,10,0">
                            <TextBlock Text="◎" FontSize="18" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Smart UI Capture" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/>
                            <TextBlock Text="UIA context + screenshots" Foreground="#64748B" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#ECFDF5" Margin="0,0,10,0">
                            <TextBlock Text="◈" FontSize="18" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AI Instruction Polish" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/>
                            <TextBlock Text="Deterministic + LLM rewrite" Foreground="#64748B" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0">
                            <TextBlock Text="↗" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Executive Exports" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/>
                            <TextBlock Text="PDF · Word · HTML · Markdown" Foreground="#64748B" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Steps or Empty State -->
            <Grid Grid.Row="3">
                <!-- Empty State -->
                <Border x:Name="EmptyState" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="44">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" MaxWidth="560">
                            <Border Width="64" Height="64" CornerRadius="16" Background="#EEF2FF" HorizontalAlignment="Left" Margin="0,0,0,18">
                                <TextBlock Text="●" FontSize="26" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Record any workflow to generate an executive guide." FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Foreground="#0F172A"/>
                            <TextBlock Text="Click 'Start capture', perform your actions in any Windows application, and SoplyraAI will automatically produce step-by-step documentation with screenshots." TextWrapping="Wrap" Foreground="#64748B" FontSize="13" LineHeight="20" Margin="0,12,20,20"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="●  Start capture" Style="{StaticResource PrimaryButton}" Click="StartCapture_Click"/>
                                <Button Content="Configure AI engine" Style="{StaticResource GhostButton}" Click="Settings_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="18" Margin="24,0,0,0" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="HOW IT WORKS" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,10,0,8">
                                    <StackPanel>
                                        <TextBlock Text="1 · Real Action Capture" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/>
                                        <TextBlock Text="Records mouse actions and queries Windows UI Automation." Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="2 · Automatic Screenshot" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/>
                                        <TextBlock Text="Captures window context and highlights the clicked element." Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="3 · Classic Light-Theme Output" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/>
                                        <TextBlock Text="Exports clean PDF and Word documents ready for distribution." Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Steps List -->
                <ScrollViewer x:Name="StepsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="StepsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GuideStep}">
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <!-- Number Badge -->
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource BrandGradient}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Screenshot Image -->
                                        <Border Grid.Column="1" Height="176" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,20,0" ClipToBounds="True" Background="#F1F5F9">
                                            <Image Source="{Binding ScreenshotPath}" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Title & Description Editor -->
                                        <StackPanel Grid.Column="2" Margin="0,2,18,0">
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="16" BorderThickness="0" Padding="0" Background="Transparent" Foreground="#0F172A"/>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="74" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10" Foreground="#334155"/>
                                            <WrapPanel>
                                                <Border Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Action}" Foreground="#4F46E5" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Context.ControlType}" Foreground="#475569" FontSize="10" FontWeight="Medium"/>
                                                </Border>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                    <TextBlock Text="{Binding Context.ProcessName}" Foreground="#475569" FontSize="10" FontWeight="Medium"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Remove Step Button -->
                                        <Button Grid.Column="3" Content="Remove" Tag="{Binding}" Style="{StaticResource DangerButton}" Margin="0" VerticalAlignment="Top" Click="DeleteStep_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>