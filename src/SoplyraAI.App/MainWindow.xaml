<Window x:Class="SoplyraAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SoplyraAI.Models"
        Title="SoplyraAI — AI Workflow Documentation" Width="1500" Height="920"
        MinWidth="1220" MinHeight="760" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#E7E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="20,24,20,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource BrandGradient}" Margin="0,0,12,0">
                            <TextBlock Text="S" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SoplyraAI" Foreground="#171824" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock Text="Workflow intelligence" Foreground="#83879B" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Record work. Generate clarity." Foreground="#777B8E" FontSize="12" Margin="0,14,0,0"/>
                </StackPanel>

                <Button Grid.Row="1" Content="＋  Create new guide" Style="{StaticResource PrimaryButton}" Margin="0,24,0,16" Click="NewGuide_Click"/>

                <Border Grid.Row="2" Background="#F4F2FF" BorderBrush="#E3DFFF" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AI ENGINE" Foreground="#6860C7" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="EngineNameText" Text="Ollama · Local" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0"/>
                                <TextBlock x:Name="EngineModelText" Text="qwen3:4b" Foreground="#74788D" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="9" Height="9" Fill="#16A374" VerticalAlignment="Top" Margin="10,3,0,0"/>
                        </Grid>
                        <TextBlock x:Name="EngineVisionText" Text="Metadata-only AI" Foreground="#74788D" FontSize="10" Margin="0,10,0,0"/>
                        <Button Content="Configure AI" Style="{StaticResource SoftButton}" Margin="0,12,0,0" Click="Settings_Click"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="RECENT GUIDES" Foreground="#8B8EA0" FontSize="10" FontWeight="Bold" Margin="2,0,0,10"/>
                    <ListBox x:Name="SessionList" SelectionChanged="SessionList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GuideSession}">
                                <Border Background="White" BorderBrush="#E6E7EF" BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#20212C" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd MMM · HH:mm}}" Foreground="#9295A5" FontSize="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="›" Foreground="#85899C" FontSize="18" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                        <Button Grid.Column="2" Content="×" Tag="{Binding}" ToolTip="Delete guide" Style="{StaticResource DangerButton}" Margin="0" VerticalAlignment="Center" Click="DeleteGuide_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Grid.Row="4" Background="#F3F9F6" BorderBrush="#DCEDE5" BorderThickness="1" CornerRadius="14" Padding="13">
                    <StackPanel>
                        <TextBlock Text="🔒  Private by design" Foreground="#246F59" FontWeight="SemiBold"/>
                        <TextBlock Text="Local sessions · DPAPI keys · Password masking · Explicit vision opt-in" Foreground="#698278" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,30,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AI DOCUMENTATION STUDIO" Foreground="#6757E8" FontSize="10" FontWeight="Bold"/>
                    <TextBox x:Name="GuideTitle" Text="Untitled guide" FontSize="29" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,5,0,0" Width="650" HorizontalAlignment="Left" LostFocus="GuideTitle_LostFocus"/>
                    <TextBlock Text="Capture any Windows workflow and turn it into polished, editable documentation." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ImproveButton" Content="✦  Improve with AI" Style="{StaticResource GhostButton}" Click="ImproveAll_Click"/>
                    <ComboBox x:Name="ExportFormatBox" Width="105" Margin="0,0,9,0" VerticalAlignment="Center">
                        <ComboBoxItem Content="PDF"/><ComboBoxItem Content="Word"/><ComboBoxItem Content="HTML"/><ComboBoxItem Content="All"/>
                    </ComboBox>
                    <Button Content="Export  ↗" Style="{StaticResource GhostButton}" Click="Export_Click"/>
                    <Button x:Name="StartButton" Content="●  Start capture" Style="{StaticResource PrimaryButton}" Margin="0" Click="StartCapture_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="White" BorderBrush="#E1E3EE" BorderThickness="1" CornerRadius="20" Padding="22" Margin="0,22,0,16">
                <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.08" Color="#514A86"/></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="13" Background="#F0EDFF" Margin="0,0,12,0"><TextBlock Text="✦" Foreground="#6757E8" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="AI that fits your workflow" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Local-first by default, with your choice of cloud provider when you need more capability." Foreground="#74788D" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel Margin="0,18,0,0">
                            <Border Background="#F8F8FC" CornerRadius="10" Padding="10,7" Margin="0,0,7,7"><TextBlock Text="Ollama" FontSize="11"/></Border>
                            <Border Background="#F8F8FC" CornerRadius="10" Padding="10,7" Margin="0,0,7,7"><TextBlock Text="DeepSeek" FontSize="11"/></Border>
                            <Border Background="#F8F8FC" CornerRadius="10" Padding="10,7" Margin="0,0,7,7"><TextBlock Text="OpenAI" FontSize="11"/></Border>
                            <Border Background="#F8F8FC" CornerRadius="10" Padding="10,7" Margin="0,0,7,7"><TextBlock Text="NVIDIA" FontSize="11"/></Border>
                            <Border Background="#F8F8FC" CornerRadius="10" Padding="10,7" Margin="0,0,7,7"><TextBlock Text="Gemini" FontSize="11"/></Border>
                            <Border Background="#F8F8FC" CornerRadius="10" Padding="10,7" Margin="0,0,7,7"><TextBlock Text="Anthropic" FontSize="11"/></Border>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#F7F6FF" BorderBrush="#E5E0FF" BorderThickness="1" CornerRadius="15" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DOCUMENTATION STYLE" Foreground="#7771B8" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="ModeStatusText" Text="Quick visual guide" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                <TextBlock Text="You choose Quick or Detailed every time capture starts." Foreground="#777B8E" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="AI settings  ⚙" Style="{StaticResource SoftButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="Settings_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#E4E6EF" BorderThickness="1" CornerRadius="15" Padding="14">
                    <StackPanel Orientation="Horizontal"><Border Width="39" Height="39" CornerRadius="12" Background="#F1EFFF" Margin="0,0,11,0"><TextBlock Text="◎" FontSize="20" Foreground="#6658E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Action-aware capture" FontWeight="SemiBold"/><TextBlock Text="Control detection + screenshot" Foreground="#7A7E91" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#E4E6EF" BorderThickness="1" CornerRadius="15" Padding="14">
                    <StackPanel Orientation="Horizontal"><Border Width="39" Height="39" CornerRadius="12" Background="#ECF8F4" Margin="0,0,11,0"><TextBlock Text="◈" FontSize="19" Foreground="#13986B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Smart AI writing" FontWeight="SemiBold"/><TextBlock Text="Metadata or optional vision" Foreground="#7A7E91" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
                </Border>
                <Border Grid.Column="4" Background="White" BorderBrush="#E4E6EF" BorderThickness="1" CornerRadius="15" Padding="14">
                    <StackPanel Orientation="Horizontal"><Border Width="39" Height="39" CornerRadius="12" Background="#EEF5FF" Margin="0,0,11,0"><TextBlock Text="↗" FontSize="19" Foreground="#2F80ED" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Reliable exports" FontWeight="SemiBold"/><TextBlock Text="PDF · Word · HTML · Markdown" Foreground="#7A7E91" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3">
                <Border x:Name="EmptyState" Background="White" BorderBrush="#E4E6EF" BorderThickness="1" CornerRadius="20" Padding="48">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" MaxWidth="570">
                            <Border Width="72" Height="72" CornerRadius="22" Background="#F0EDFF" HorizontalAlignment="Left" Margin="0,0,0,20"><TextBlock Text="●" FontSize="31" Foreground="#6757E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Document the process while you do the work." FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Start capture, work normally, and SoplyraAI records each click, captures the resulting screen, understands the UI control, and prepares the documentation automatically." TextWrapping="Wrap" Foreground="#74788D" FontSize="13" LineHeight="21" Margin="0,12,20,22"/>
                            <StackPanel Orientation="Horizontal"><Button Content="●  Start first capture" Style="{StaticResource PrimaryButton}" Click="StartCapture_Click"/><Button Content="Choose AI engine" Style="{StaticResource GhostButton}" Click="Settings_Click"/></StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#FAFAFD" BorderBrush="#E7E8F0" BorderThickness="1" CornerRadius="18" Padding="20" Margin="30,0,0,0" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="WHAT YOU GET" Foreground="#8B8EA0" FontSize="10" FontWeight="Bold"/>
                                <Border Background="White" BorderBrush="#E8E9F1" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,13,0,10"><StackPanel><TextBlock Text="1 · Screenshot" FontWeight="SemiBold"/><TextBlock Text="The screen after the click, with the target highlighted." Foreground="#777B8E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                                <Border Background="White" BorderBrush="#E8E9F1" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="2 · What was clicked" FontWeight="SemiBold"/><TextBlock Text="Button, tab, field, menu, application and window context." Foreground="#777B8E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                                <Border Background="White" BorderBrush="#E8E9F1" BorderThickness="1" CornerRadius="13" Padding="14"><StackPanel><TextBlock Text="3 · Clear explanation" FontWeight="SemiBold"/><TextBlock Text="One sentence in Quick mode or a few useful lines in Detailed SOP mode." Foreground="#777B8E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="StepsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="StepsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GuideStep}">
                                <Border Background="White" BorderBrush="#E3E5EE" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.05" Color="#5B5875"/></Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource BrandGradient}" VerticalAlignment="Top"><TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Grid.Column="1" Height="172" BorderBrush="#ECECF3" BorderThickness="1" CornerRadius="12" Margin="0,0,20,0" ClipToBounds="True" Background="#F7F7FA"><Image Source="{Binding ScreenshotPath}" Stretch="UniformToFill"/></Border>
                                        <StackPanel Grid.Column="2" Margin="0,2,18,0">
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="17" BorderThickness="0" Padding="0" Background="Transparent"/>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="76" MaxHeight="112" VerticalScrollBarVisibility="Auto" Margin="0,10,0,11"/>
                                            <WrapPanel>
                                                <Border Background="#F2F0FF" CornerRadius="8" Padding="9,5" Margin="0,0,7,0"><TextBlock Text="{Binding Action}" Foreground="#6355D4" FontSize="10"/></Border>
                                                <Border Background="#F6F7FA" CornerRadius="8" Padding="9,5" Margin="0,0,7,0"><TextBlock Text="{Binding Context.ControlType}" Foreground="#6D7185" FontSize="10"/></Border>
                                                <Border Background="#F6F7FA" CornerRadius="8" Padding="9,5"><TextBlock Text="{Binding Context.ProcessName}" Foreground="#6D7185" FontSize="10"/></Border>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="Remove" Tag="{Binding}" Style="{StaticResource DangerButton}" Margin="0" VerticalAlignment="Top" Click="DeleteStep_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
